---
/**
 * Magazine-style post card: colored kicker band + title + date + clamped desc.
 * No cover image — accent comes from postVisual color tokens.
 */
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/base';
import { getPostVisual } from '../utils/postVisual';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const href = withBase(`/posts/${post.slug}/`);
const { kicker, displayTitle, accentVar } = getPostVisual(title, tags, post.slug);
---

<article class="post-card" style={`--card-accent: ${accentVar};`}>
  <div class="post-card__band">
    <span class="post-card__kicker">{kicker}</span>
    <h3 class="post-card__title">
      <a href={href}>{displayTitle}</a>
    </h3>
  </div>
  <div class="post-card__body">
    <div class="post-card__meta">
      <FormattedDate date={pubDate} />
    </div>
    {description && <p class="post-card__desc">{description}</p>}
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: var(--transition-lift);
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .post-card__band {
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-top: 4px solid var(--card-accent, var(--color-accent));
    background-color: color-mix(in srgb, var(--card-accent, var(--color-accent)) 8%, var(--color-bg-elevated));
  }

  .post-card__kicker {
    display: block;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--card-accent, var(--color-accent));
    margin-bottom: var(--space-2);
  }

  .post-card__title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .post-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Expand hit area to the whole card without nesting links */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card__title a:hover {
    color: var(--card-accent, var(--color-link));
    text-decoration: none;
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card:has(.post-card__title a:focus-visible) {
    outline: 2px solid var(--card-accent, var(--color-accent));
    outline-offset: 2px;
  }

  .post-card__body {
    padding: 0 var(--space-4) var(--space-4);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-card__meta {
    font-size: 0.8rem;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-2);
  }

  .post-card__desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card:hover {
      transform: none;
    }
  }
</style>
