---
import PostCard from '../../../components/PostCard.astro';
import { defaultLang, t } from '../../../i18n/ui';
/**
 * Tag detail: lists all posts under a given tag in magazine grid.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../utils/base';
import { getTagMap } from '../../../utils/posts';

export async function getStaticPaths() {
  const tagMap = await getTagMap();
  return [...tagMap.keys()].map((tag) => {
    const tagPosts = tagMap.get(tag) ?? [];
    return {
      params: { tag },
      props: {
        tag,
        posts: [...tagPosts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
      },
    };
  });
}

const { tag, posts } = Astro.props;
const backLabel = t('tags.back', defaultLang);
const tagsHref = withBase('/tags/');
---

<BaseLayout title={`#${tag}`} wide>
  <a href={tagsHref} class="back-link">{backLabel}</a>
  <h1 class="page-title">#{tag}</h1>
  <p class="count">共 {posts.length} 篇</p>
  <div class="post-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--color-text-subtle);
    margin: var(--space-8) 0 var(--space-4);
  }

  .page-title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-1);
  }

  .count {
    color: var(--color-text-subtle);
    font-size: 0.9rem;
    margin-bottom: var(--space-8);
  }
</style>
