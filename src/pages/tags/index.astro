---
import { defaultLang, t } from '../../i18n/ui';
/**
 * Tag cloud — all tags with their post counts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/base';
import { getTagMap } from '../../utils/posts';

const tagMap = await getTagMap();
const titleLabel = t('tags.title', defaultLang);
const countLabel = t('tags.count', defaultLang);
const maxCount = Math.max(1, ...[...tagMap.values()].map((p) => p.length));
---

<BaseLayout title={titleLabel} wide>
  <h1 class="page-title">{titleLabel}</h1>
  <p class="page-lead">按主题浏览文章</p>
  {
    tagMap.size > 0 ? (
      <ul class="tag-cloud">
        {[...tagMap.entries()].map(([tag, posts]) => {
          const weight = posts.length / maxCount;
          const fontScale = 0.95 + weight * 0.55;
          return (
            <li>
              <a
                href={withBase(`/tags/${encodeURIComponent(tag)}/`)}
                style={`--scale:${fontScale};`}
              >
                <span class="tag-name">#{tag}</span>
                <span class="tag-count">{posts.length} {countLabel}</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty">暂无标签</p>
    )
  }
</BaseLayout>

<style>
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: var(--space-8) 0 var(--space-2);
  }

  .page-lead {
    color: var(--color-text-subtle);
    font-size: 0.95rem;
    margin: 0 0 var(--space-8);
  }

  .tag-cloud {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-3);
    padding: 0;
    margin: 0;
  }

  .tag-cloud a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 0.45em 1em;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-tag-text);
    font-size: calc(1rem * var(--scale, 1));
    transition: var(--transition-colors);
  }

  .tag-cloud a:hover {
    background-color: var(--color-bg-muted);
    border-color: var(--color-text-muted);
    color: var(--color-link);
    text-decoration: none;
  }

  .tag-count {
    font-size: 0.7em;
    color: var(--color-text-subtle);
  }

  .empty {
    color: var(--color-text-subtle);
  }
</style>
